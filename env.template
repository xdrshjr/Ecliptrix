# Ecliptrix Environment Configuration
# Copy this file to .env.local and fill in your actual values

# General LLM API Configuration (Recommended)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-3.5-turbo

# LLM API Configuration
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API_URL=https://api.anthropic.com

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1

# Azure OpenAI (Optional)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# Custom LLM Endpoint (Optional)
CUSTOM_LLM_API_KEY=your_custom_llm_api_key_here
CUSTOM_LLM_API_URL=https://your-custom-llm-endpoint.com/v1

# AI Video Match LLM Configuration (Alibaba Cloud Qwen)
AI_VIDEO_MATCH_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VIDEO_MATCH_LLM_API_KEY=your_alibaba_cloud_api_key_here
AI_VIDEO_MATCH_LLM_MODEL=qwen-max-latest

# Application Configuration
NEXT_PUBLIC_APP_NAME=Ecliptrix
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# AI Material Service Configuration
# Options: local, runninghub
NEXT_PUBLIC_AI_MATERIAL_SERVICE=local

# Backend Service Configuration
# 后台FastAPI服务地址 - 部署时需要修改为实际服务器地址
# 用于Next.js API路由调用Python后端服务
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# 前端Next.js服务地址 - 仅用于测试端点（test-node等）
# 生产环境需要设置为实际的前端服务地址
NEXT_PUBLIC_API_URL=http://localhost:3000
# 前端API基础URL - 通常不需要修改，使用相对路径
NEXT_PUBLIC_API_BASE_URL=

# Database Configuration (for future use)
DATABASE_URL=your_database_connection_string_here

# Redis Configuration (for caching, future use)
REDIS_URL=your_redis_connection_string_here

# File Storage Configuration (for future use)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# Security
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Logging
LOG_LEVEL=info 