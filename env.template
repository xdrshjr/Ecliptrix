# Ecliptrix Environment Configuration
# Copy this file to .env.local and fill in your actual values

# General LLM API Configuration (Recommended)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-3.5-turbo

# Fast LLM Configuration (for translate-search-query and other fast operations)
# Uses Alibaba Cloud Qwen for faster response times
FAST_LLM_API_KEY=***REMOVED***
FAST_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FAST_LLM_MODEL=qwen3-next-80b-a3b-instruct

# LLM API Configuration
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API_URL=https://api.anthropic.com

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1

# Azure OpenAI (Optional)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# Custom LLM Endpoint (Optional)
CUSTOM_LLM_API_KEY=your_custom_llm_api_key_here
CUSTOM_LLM_API_URL=https://your-custom-llm-endpoint.com/v1

# AI Video Match LLM Configuration (Alibaba Cloud Qwen)
AI_VIDEO_MATCH_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VIDEO_MATCH_LLM_API_KEY=your_alibaba_cloud_api_key_here
AI_VIDEO_MATCH_LLM_MODEL=qwen-max-latest

# Application Configuration
NEXT_PUBLIC_APP_NAME=Ecliptrix
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# AI Material Service Configuration
# Options: local, runninghub
NEXT_PUBLIC_AI_MATERIAL_SERVICE=local

# Backend Service Configuration
# ---------------------------------------------------------------------------
# BACKEND_URL — single source of truth for the FastAPI backend address.
# Read by `src/lib/config/backend.ts` exactly once at Next.js server boot.
# If unset, the Next.js server fails fast at startup (no silent fallback).
# Server-side only — NOT exposed to the browser. Change the port here when
# the backend moves between dev (8000) and production (8088).
BACKEND_URL=http://localhost:8000
#
# DEPRECATED — DO NOT USE (kept here for documentation only):
#   BACKEND_SERVICE_URL  ← no longer read by any code; safe to delete
#   PYTHON_BACKEND_URL   ← no longer read by any code; safe to delete
# These names previously coexisted with BACKEND_URL and caused a production
# outage on 2026-04-07. They are now no-ops; if you still have them defined
# in your .env.local, the Next.js server will warn at boot. Remove them to
# silence the warning. See:
#   docs/plans/unified-api-auth-refactor/specs/02-backend-url-config-module.md
# ---------------------------------------------------------------------------
# 前端Next.js服务地址 - 仅用于测试端点（test-node等）
# 生产环境需要设置为实际的前端服务地址
NEXT_PUBLIC_API_URL=http://localhost:3000
#
# AGENT_LOOPBACK_PORT — port the video-editing Agent uses for server-side
# tool callbacks. Agent tools make fetch() calls back into the local Next.js
# process (e.g. `/api/video-search`, `/api/translate-search-query`). In
# production these MUST be loopback URLs — using the public origin causes
# `TypeError: fetch failed` because the node runtime can't round-trip
# through nginx/HTTPS back to itself (see diagnosis 2026-04-07).
#
# Resolution order inside the Agent:
#   1. AGENT_LOOPBACK_PORT (explicit override, recommended)
#   2. PORT  (set automatically by ops/templates/ecliptrix-frontend.service)
#   3. 3000  (Next.js dev default)
#
# Only set this if you run the frontend outside of ops/install.sh (e.g. pm2,
# docker compose, or a custom port). For install.sh-based deploys the
# systemd service already exports PORT=<FRONTEND_PORT>, so this can stay
# unset.
# AGENT_LOOPBACK_PORT=3088
#
# REMOVED in unified-api-auth-refactor S06 (2026-04-07): the two
# NEXT_PUBLIC_* backend-URL env vars that previously bypassed the BFF and
# leaked the backend address into the browser bundle. The browser now goes
# through Next.js proxy routes under `/api/*`, which read `BACKEND_URL`
# (server-side only). If your local `.env.local` still has them, delete
# them. See:
#   docs/plans/unified-api-auth-refactor/specs/06-direct-browser-call-migration.md

# Database Configuration (for future use)
DATABASE_URL=your_database_connection_string_here

# Redis Configuration (for caching, future use)
REDIS_URL=your_redis_connection_string_here

# File Storage Configuration (for future use)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# Security
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# UI Hints
# Optional: show dev-only hints (e.g. test credentials) on the login modal. Default off.
NEXT_PUBLIC_SHOW_DEV_HINTS=false
