    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "next": "^15.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1",
    "tailwindcss-animate": "^1.0.7",
