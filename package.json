{
  "name": "ecliptrix",
  "version": "1.0.0",
  "private": true,
  "description": "Ecliptrix - Where light and shadow collide. A content creation platform for social media, video editing, voice synthesis, and creative brainstorming.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scan:secrets": "python scripts/scan-secrets.py",
