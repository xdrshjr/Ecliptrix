# Ecliptrix 日志轮转配置
# 由 web-deployer skill 生成

@@PROJECT_DIR@@/logs/*.log
@@BACKEND_DIR@@/logs/*.log
{
    daily
    rotate 7
    size 50M
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    copytruncate
    su @@RUN_USER@@ @@RUN_GROUP@@
    create 0644 @@RUN_USER@@ @@RUN_GROUP@@
}
