[Unit]
Description=Ecliptrix Watchdog Timer (每 @@WATCHDOG_INTERVAL@@s 触发健康检查)

[Timer]
# 服务启动后 30s 第一次触发
OnBootSec=30s
# 每隔 WATCHDOG_INTERVAL 秒触发一次（相对于上次完成）
OnUnitInactiveSec=@@WATCHDOG_INTERVAL@@s
Unit=@@PROJECT_NAME@@-watchdog.service
AccuracySec=5s
Persistent=true

[Install]
WantedBy=timers.target
