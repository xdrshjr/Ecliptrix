# Ecliptrix nginx 站点配置
# 由 web-deployer skill 生成 — 2026-04-07
# HTTP 配置（如需 SSL，运行 certbot --nginx -d ecliptrix.com -d www.ecliptrix.com）

upstream ecliptrix_backend {
    server 127.0.0.1:@@BACKEND_PORT@@;
    keepalive 32;
}

upstream ecliptrix_frontend {
    server 127.0.0.1:@@FRONTEND_PORT@@;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@NGINX_DOMAIN@@;

    # 上传大小限制（视频可能较大）
    client_max_body_size 500m;
    client_body_timeout 600s;
    client_header_timeout 60s;

    # 访问/错误日志
    access_log /var/log/nginx/ecliptrix.access.log;
    error_log  /var/log/nginx/ecliptrix.error.log;

    # 安全 header
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/json
               application/javascript application/xml+rss application/xml
               image/svg+xml;

    # ===== /api/* 路由 =====
    # 重要：Ecliptrix 的 /api/* 是 Next.js 前端的 server route（src/app/api/*/route.ts），
    # 不是 FastAPI 后端路由。Next.js handler 内部再用 BACKEND_URL 调 FastAPI 或直连 LLM。
    # 因此 /api/* 必须代理到 Next.js (前端 3088)，不能代理到 FastAPI。
    location /api/ {
        proxy_pass http://ecliptrix_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # SSE / 长连接（agent chat 流式响应）
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 60s;
        chunked_transfer_encoding on;
    }

    # FastAPI 自身 docs / openapi 直通（用于调试，绕过 Next.js）
    location ~ ^/(docs|redoc|openapi.json) {
        proxy_pass http://ecliptrix_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # FastAPI static 文件直通（/static/timeline_exports 等直接挂载的目录）
    location /static/ {
        proxy_pass http://ecliptrix_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
    }

    # ===== 前端 Next.js =====
    location / {
        proxy_pass http://ecliptrix_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # SSE / streaming（agent 会话最长 1 小时）
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 60s;
        chunked_transfer_encoding on;
    }

    # Next.js 静态资源（缓存）
    location /_next/static/ {
        proxy_pass http://ecliptrix_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_valid 200 1y;
        add_header Cache-Control "public, immutable, max-age=31536000";
    }
}
