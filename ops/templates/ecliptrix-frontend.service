[Unit]
Description=Ecliptrix Frontend (Next.js)
After=network-online.target ecliptrix-backend.service
Wants=network-online.target

[Service]
Type=simple
User=@@RUN_USER@@
Group=@@RUN_GROUP@@
WorkingDirectory=@@FRONTEND_DIR@@
EnvironmentFile=-@@FRONTEND_DIR@@/.env
Environment=NODE_ENV=production
Environment=PORT=@@FRONTEND_PORT@@
Environment=HOSTNAME=0.0.0.0
Environment=NODE_OPTIONS=--max-old-space-size=2048

# 启动 Next.js production server
ExecStart=@@NPX_BIN@@ next start -p @@FRONTEND_PORT@@ -H 0.0.0.0

# 重启策略
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=300
StartLimitBurst=5

# 资源限制
LimitNOFILE=65535
MemoryMax=3G

# 优雅停止
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecliptrix-frontend

[Install]
WantedBy=multi-user.target
