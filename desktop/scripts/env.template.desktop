# ============================================================================
# Ecliptrix 桌面版 - 环境配置
#
# 这份文件在首次启动时被复制到应用数据目录(Windows 下通常是
# %APPDATA%\Ecliptrix\.env)。外部服务密钥一律用占位符(your_*_here),请把真实
# 密钥填进复制出来的 .env,不要回填到仓库里的模板;占位值(your_*_here)在启动时
# 会被自动忽略,不会作为假凭证注入服务。例外:根管理员账号 ROOT_USERNAME /
# ROOT_PASSWORD 携带真实出厂默认值(admin / admin),它是登录界面要输入的账号,
# 升级安装时旧默认口令会被自动迁移到此值(见 envCheck.js STALE_FACTORY_ROOT_PASSWORDS)。
#
# ⚠️ 以下变量由桌面端主进程在启动时强制注入,写在本文件中不会生效:
#   DATABASE_URL          (固定为 userData/data/ecliptrix.db 的 SQLite)
#   STORAGE_ROOT          (固定为 userData/storage)
#   HOST / PORT           (固定为 127.0.0.1 + desktop-config.json 中的端口)
#   CORS_ALLOWED_ORIGINS  (固定为本地前端地址)
# 如需调整端口,请编辑同目录下的 desktop-config.json。
# ============================================================================

# ===========================================
# LLM 配置(可选 — 推荐启动应用后登录,在 设置 → 模型设置 中配置)
# 此处的值仅作为环境变量回退,且 your_*_here 占位值会被忽略。
# 通用对话 / 工作流 / 意图识别;同时透传给前端的 chat 直连路由。
# *_API_TYPE: openai(默认,OpenAI 兼容)或 anthropic
# ===========================================
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-next-80b-a3b-instruct
LLM_API_TYPE=openai

# 快速 LLM(翻译、搜索词扩展等轻量操作;可选)
FAST_LLM_API_KEY=your_fast_llm_api_key_here
FAST_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FAST_LLM_MODEL=qwen3-next-80b-a3b-instruct
FAST_LLM_API_TYPE=openai

# AI 混剪 LLM(可选)
VIDEO_CUT_LLM_API_KEY=your_video_cut_llm_api_key_here
VIDEO_CUT_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_CUT_LLM_MODEL=qwen3-next-80b-a3b-instruct
VIDEO_CUT_LLM_API_TYPE=openai

# 视觉理解 LLM(视频帧分析;可选)
VL_LLM_API_KEY=your_vl_llm_api_key_here
VL_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_LLM_MODEL=qwen-vl-plus
VL_LLM_API_TYPE=openai

# 工作流 Agent LLM(可选,可按 01/02/... 编号扩展)
AGENT_LLM_API_01_KEY=your_agent_llm_01_key_here
AGENT_LLM_API_01_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_01_MODEL=qwen3-next-80b-a3b-instruct
AGENT_LLM_API_01_TYPE=openai

# ===========================================
# 根管理员账号(首次启动时写入本地数据库;.env 是 root 账号的唯一事实来源)
# 桌面端启动后会弹出登录界面,需用以下账号密码手动登录。
# ===========================================
ROOT_USERNAME=admin
ROOT_PASSWORD=admin

# 邀请码(可选;设置后用户自助注册需提供该码,留空关闭自助注册)
INVITE_CODE=

# ===========================================
# 外部素材 / 搜索 API(均为可选,缺失时对应功能按既有逻辑降级)
# ===========================================
# Pexels — 视频素材搜索(支持逗号分隔多 key)
PEXELS_API_KEY=your_pexels_api_key_here
# Unsplash — 图片搜索(支持逗号分隔多 key)
UNSPLASH_ACCESS_KEYS=your_unsplash_key_here
# 字节跳动 ARK — AI 视频/图片生成(Seedance / Seedream)
ARK_API_KEY=your_ark_api_key_here
# Freesound — 音频素材
FREESOUND_API_KEY=your_freesound_api_key_here
# RunningHub — FLUX 图片生成
RUNNING_HUB_API_KEY=your_running_hub_api_key_here

# ===========================================
# 火山引擎 TTS / ASR(可选;配置后启用语音合成与字幕转录)
# ===========================================
VOLCANO_TTS_API_KEY=your_volcano_tts_api_key_here
VOLCANO_TTS_RESOURCE_ID=seed-tts-2.0
# 旧版凭据 — ASR / 声音克隆回退链路仍会读取
VOLCANO_TTS_APPID=your_volcano_tts_appid_here
VOLCANO_TTS_ACCESS_TOKEN=your_volcano_tts_access_token_here
VOLCANO_TTS_SECRET_KEY=your_volcano_tts_secret_key_here

# ===========================================
# YouTube 代理(可选;本机无法直连 YouTube 时配置)
# 支持 socks5://host:port、http://host:port
# ===========================================
YOUTUBE_PROXY=

# ===========================================
# 运行参数(一般无需改动)
# ===========================================
DEBUG=false
LOG_LEVEL=INFO
ENV=production
