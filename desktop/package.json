{
  "name": "ecliptrix-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Ecliptrix desktop (Electron) shell and Windows packaging scripts",
  "author": "Ecliptrix",
  "main": "main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:attach": "electron . --dev",
    "build": "node scripts/build.js",
    "build:dir": "node scripts/build.js --dir",
    "smoke-test": "node scripts/smoke-test.js",
    "verify:research": "node scripts/verify-research-release.js",
    "test:logger": "node scripts/test-logger.js",
    "test:auth": "node scripts/test-auth.js",
    "test:browser": "node scripts/test-browser-workspace.js",
    "spike:browser": "electron scripts/browser-workspace-spike.js",
    "test:browser:e2e": "electron scripts/browser-workspace-e2e.js",
    "clean": "node scripts/build.js --clean"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
