# =============================================================================
# Ecliptrix account server — environment template
#
# Copy to `.env` and fill in the three required values. Everything else has a
# safe default. This file holds SECRETS: never commit it.
#
# Generate a session secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

NODE_ENV=development

# Bind address. `0.0.0.0` inside Docker; `127.0.0.1` behind Nginx on bare metal.
PORT=8787
HOST=0.0.0.0

# --- required ----------------------------------------------------------------
# SQLite file. The parent directory is created on boot. Relative to cwd.
DATABASE_PATH=./data/webserver.db

# Public origin of this service. Used for cookie scoping, password-reset links
# and the desktop client's base URL. No trailing slash.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# >= 32 bytes of entropy. Derives the HMAC key for stored token hashes and the
# CSRF secret. Rotating it invalidates every session (intended).
SESSION_SECRET=change-me-please-generate-a-48-byte-random-string

# --- bootstrap super admin ---------------------------------------------------
# Created (or promoted) on every boot. The password is written only when the
# account has no hash yet, or when RESET_ROOT_ADMIN_PASSWORD=true.
#
# ROOT_ADMIN_USERNAME must match the deployment requirement "the root
# administrator is xdrshjr": a copied .env makes this key present, which SHADOWS
# the code default, so leaving the old `owner` here silently produced an
# installation whose root account was not the one asked for (review R-V4-06).
#
# The password below is a placeholder. Replace it BEFORE the first boot and rotate
# it again immediately afterwards; the console's security posture page reports the
# account as "still on the bootstrap password" until the hash changes once.
ROOT_ADMIN_EMAIL=owner@example.com
ROOT_ADMIN_PASSWORD=change-me-before-first-boot
ROOT_ADMIN_USERNAME=xdrshjr
RESET_ROOT_ADMIN_PASSWORD=false

# --- registration ------------------------------------------------------------
REGISTRATION_ENABLED=true
INVITE_REQUIRED=false

# --- session lifetimes -------------------------------------------------------
ACCESS_TOKEN_TTL_HOURS=12
REFRESH_TOKEN_TTL_DAYS=30
DESKTOP_REFRESH_TOKEN_TTL_DAYS=90

# --- brute-force protection --------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- CORS --------------------------------------------------------------------
# Comma separated origins allowed to call /api/v1 from a browser. Empty is
# correct for first-party web + desktop (the desktop sends no Origin header).
CORS_ALLOWED_ORIGINS=

# --- mail (optional) ---------------------------------------------------------
# Leave SMTP_HOST empty to disable self-service password reset; the console
# then issues one-time temporary passwords instead (spec §2.10).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ecliptrix <no-reply@example.com>
# Upper bound for one delivery attempt, in milliseconds (500..20000). It is applied
# to the connection, the greeting AND the socket, because nodemailer's default
# socketTimeout is one hour: without this value a dead SMTP host hangs whatever
# awaited the send.
MAIL_SEND_TIMEOUT_MS=5000

# --- client release artifacts ------------------------------------------------
# Where uploaded desktop installers live. MUST NOT be inside `public/` or the
# standalone build output: `next start` does not serve files added to `public/`
# after the build, so an installer copied there uploads fine and then 404s for
# every user. Default: a `releases/` directory next to DATABASE_PATH, which keeps
# it inside the directory the systemd unit already grants write access to.
# RELEASES_DIR=/opt/webserver/data/releases

# --- operations --------------------------------------------------------------
TRUST_PROXY=true
LOG_LEVEL=info
# `true` in development, `false` in production by default: production must run
# `npm run db:migrate` explicitly so a schema drift can never happen silently.
AUTO_MIGRATE=
