# Ecliptrix account server — Nginx reverse proxy example.
#
# Terminates TLS and forwards to the single Node process. Copy to
# /etc/nginx/sites-available/webserver, adjust server_name and certificate paths,
# then `nginx -t && systemctl reload nginx`.

upstream ecliptrix_webserver {
    server 127.0.0.1:8787;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name id.ecliptrix.app;

    # Everything except the ACME challenge goes to HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name id.ecliptrix.app;

    ssl_certificate     /etc/letsencrypt/live/id.ecliptrix.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/id.ecliptrix.app/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Request bodies are capped at the application's own limit plus headroom.
    # This default is deliberately small: it covers every JSON endpoint. The
    # installer-upload location below overrides it, and ONLY that location —
    # raising it globally would give /login and /register a 1 GiB denial-of-service
    # surface for free.
    client_max_body_size 1m;
    # Between two successful reads, not a total duration: a slow but steady 188 MB
    # upload does not trip it, a stalled one does.
    client_body_timeout  15s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # The application sets its own CSP and friends; do not duplicate them here,
    # a second header would intersect with the first and silently break inline
    # styles that the console needs.

    access_log /var/log/nginx/ecliptrix-webserver.access.log;
    error_log  /var/log/nginx/ecliptrix-webserver.error.log warn;

    location /_next/static/ {
        proxy_pass http://ecliptrix_webserver;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Installer upload — the ONE location allowed to carry a huge body.
    #
    # `Ecliptrix-Setup.exe` is ~188 MB, so the inherited 1m would answer 413 to
    # every real upload. `proxy_request_buffering off` is load-bearing: with it on
    # (the default) nginx spools the entire request body to disk before forwarding
    # it, so every upload costs 188 MB of nginx temp space plus an extra copy, and
    # the progress bar the console shows describes a transfer nginx already
    # finished receiving. `proxy_read_timeout` is raised for slow links.
    location ~ ^/api/v1/admin/releases {
        proxy_pass http://ecliptrix_webserver;
        proxy_http_version 1.1;
        client_max_body_size 1024m;
        client_body_timeout  120s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Installer download needs no bigger body limit but does need a long read
    # timeout: a 188 MB response over a slow link outlives the 30s default.
    location ~ ^/api/v1/downloads/ {
        proxy_pass http://ecliptrix_webserver;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 300s;
    }

    location /api/ {
        proxy_pass http://ecliptrix_webserver;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # $remote_addr, NOT $proxy_add_x_forwarded_for: the latter APPENDS the real
        # address to whatever the client already sent, so the first entry of the
        # header stays attacker-controlled. Every IP-keyed rate limit (login
        # 20/5min, register 10/h, reset 3/h), the lockout accounting and the audit
        # `ip` field would then be forgeable by rotating a fake prefix per request.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 30s;
        proxy_buffering off;
    }

    # The two routes whose URL carries a one-time token. `add_header` replaces the
    # inherited set for this location, so Referrer-Policy has to be spelled out
    # here; the application sends `no-referrer` for them as well (middleware).
    location ~ ^/(verify-email|confirm-deletion) {
        proxy_pass http://ecliptrix_webserver;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        add_header Referrer-Policy "no-referrer" always;
    }

    location / {
        proxy_pass http://ecliptrix_webserver;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # $remote_addr, NOT $proxy_add_x_forwarded_for: the latter APPENDS the real
        # address to whatever the client already sent, so the first entry of the
        # header stays attacker-controlled. Every IP-keyed rate limit (login
        # 20/5min, register 10/h, reset 3/h), the lockout accounting and the audit
        # `ip` field would then be forgeable by rotating a fake prefix per request.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 30s;
    }
}
