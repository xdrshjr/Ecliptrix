{
  "name": "ecliptrix-webserver",
  "version": "0.1.0",
  "private": true,
  "description": "Ecliptrix account server — Supabase-style landing page, account centre and admin console for Ecliptrix desktop users.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 8787",
    "build": "next build",
    "start": "next start -p 8787",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backup": "node scripts/backup.mjs",
    "db:prune": "tsx scripts/prune.ts",
    "accounts:sweep": "tsx scripts/sweep.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "user:create": "tsx scripts/create-user.ts",
    "user:reset": "tsx scripts/reset-password.ts",
    "user:verify": "tsx scripts/user-verify.ts",
    "account:confirm-deletion": "tsx scripts/confirm-deletion.ts",
    "release:publish": "tsx scripts/release-publish.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.4.5",
    "nodemailer": "^6.9.16",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
