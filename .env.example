# Ecliptrix Environment Configuration
# Copy this file to .env.local and fill in your actual values

# General LLM API Configuration (Recommended)
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=***REMOVED***
LLM_MODEL=deepseek-v3

# AI_VIDEO_MATCH_LLM
AI_VIDEO_MATCH_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VIDEO_MATCH_LLM_API_KEY=***REMOVED***
AI_VIDEO_MATCH_LLM_MODEL=qwen-max-latest

# BACKEND SERVICE URL — read by `src/lib/config/backend.ts` (server-only).
# The previous NEXT_PUBLIC_* variant was removed in S06: it leaked the
# backend address into the browser bundle and bypassed the BFF.
BACKEND_URL=http://localhost:8000

# ComfyUI API Service
COMFY_API_SERVICE_URL=http://192.168.1.48:8001

# AI Material, local, runninghub
NEXT_PUBLIC_AI_MATERIAL_SERVICE=runninghub

# Application Configuration
NEXT_PUBLIC_APP_NAME=Ecliptrix
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# Database Configuration (for future use)
DATABASE_URL=your_database_connection_string_here

# Redis Configuration (for caching, future use)
REDIS_URL=your_redis_connection_string_here

# File Storage Configuration (for future use)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# Security
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# YouTube Proxy (backend, for server that cannot access YouTube directly)
# Supports: socks5://host:port, http://host:port
YOUTUBE_PROXY=

# Logging
LOG_LEVEL=info

# ===========================================
# Playback v2 (Phase 4 §4.3 / D3)
# Front-end feature flag + client-side kill-switch thresholds.
# Backend has its own twin pair under backend-services/basic-service/env.template.
# ===========================================
# Coarse on/off — falls through to the rollout-percent / force-id paths
# resolved by /api/config/playback-flag when unset.
# NEXT_PUBLIC_PLAYBACK_V2_ENABLED=false
# Optional dev / staging deploy hint. The variant override (set via the
# in-app switcher) is only honored when this is "development" / "staging".
# NEXT_PUBLIC_DEPLOY_ENV=development
# Client-side kill-switch — a single session that exceeds either counter
# trips ecliptrix-playback-v2-killswitch and forces legacy on next reload.
# NEXT_PUBLIC_PLAYBACK_V2_KILLSWITCH_REGRESSION=50
# NEXT_PUBLIC_PLAYBACK_V2_KILLSWITCH_STALLED=30
