{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "prefer-const": "error",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-explicit-any": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.name='fetch'][arguments.0.type='Literal'][arguments.0.value=/^\\u002Fapi\\u002F/]",
        "message": "Do not call fetch('/api/...') directly. Use the http-client wrapper from '@/lib/api/http-client' so the call gets the shared timeout, abort handling and typed error envelope. See src/lib/api/http-client.ts."
      },
      {
        "selector": "CallExpression[callee.name='fetch'][arguments.0.type='TemplateLiteral'][arguments.0.quasis.0.value.raw=/^\\u002Fapi\\u002F/]",
        "message": "Do not call fetch(`/api/...`) directly. Use the http-client wrapper from '@/lib/api/http-client'."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/app/api/**/*", "**/__tests__/**/*", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ]
}