/node_modules/
static/uploads/
venv/
backend-services/basic-service/data/
.web-debugger/

# Local env files — were previously tracked, which silently overwrote
# prod's BACKEND_URL on every tarball-extract deploy (2026-04-07 incident).
# Use leading slash so .env.example and env-config/*/.env stay tracked.
/.env
/backend-services/basic-service/.env

# Backup files (e.g. .env.bak, db.sqlite.bak) — these often contain
# secrets and shouldn't be checked in.
*.bak

# Python bytecode cache — regenerated by every Python invocation, should
# never be in version control. Hundreds were tracked before this commit.
__pycache__/
*.pyc
*.pyo

# Next.js build output — regenerated by `next build`.
.next/

# TypeScript incremental compilation cache — regenerated by `tsc`.
tsconfig.tsbuildinfo

# JetBrains IDE settings (user-specific).
.idea/

# Playwright CLI cache — regenerated as needed.
.playwright-cli/
