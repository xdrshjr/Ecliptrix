/node_modules/
static/uploads/
venv/
backend-services/basic-service/data/
.web-debugger/

# Local env files — were previously tracked, which silently overwrote
# prod's BACKEND_URL on every tarball-extract deploy (2026-04-07 incident).
# Use leading slash so .env.example and env-config/*/.env stay tracked.
/.env
/backend-services/basic-service/.env

# Backup files (e.g. .env.bak, db.sqlite.bak) — these often contain
# secrets and shouldn't be checked in.
*.bak

# Python bytecode cache — regenerated by every Python invocation, should
# never be in version control. Hundreds were tracked before this commit.
__pycache__/
*.pyc
*.pyo

# Next.js build output — regenerated by `next build`.
.next/

# TypeScript incremental compilation cache — regenerated by `tsc`.
tsconfig.tsbuildinfo

# JetBrains IDE settings (user-specific).
.idea/

# Playwright CLI cache — regenerated as needed.
.playwright-cli/

# === Secrets (spec/05 V05-B) ===
# Blanket-block .env files anywhere in the tree, allowlist templates.
.env
.env.*
**/.env
**/.env.*
!**/env.template
!**/.env.example

# === Key material (2026-10-27 incident: an SSH private key sat in ops/key/) ===
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
id_rsa*
id_ed25519*
ops/key/
secrets/

# === Local secret-scanner output ===
.secret-scan/
# === Python ===
*.pyd
.pytest_cache/
.coverage
htmlcov/

# === Next.js / Node ===
out/
*.tsbuildinfo

# === Editors ===
.vscode/

# === Logs (spec/05 V05-D — 历史泄露 2834 次 Bearer JWT) ===
*.log
backend-services/basic-service/logs/

# === Cached materials (large remote-fetched binaries) ===
backend-services/basic-service/static/cached_materials/

# === Transitional safety net for spec/05 V05-A recovery (.env*.local.backup) ===
*.local.backup

# === Desktop (Electron) packaging (docs/plans/desktop-electron-packaging) ===
# Root /node_modules/ rule above is anchored, so desktop/ needs its own.
desktop/node_modules/
desktop/build/
desktop/release/
desktop/cache/
# Dev-time categorised logs (docs/plans/desktop-logging-categorization). The
# `*.log` rule above only matches the active file, NOT rotated `*.log.1/.2/.3`,
# so the whole directory must be ignored.
desktop/logs/

# === Generated media (docs/plans/dead-code-cleanup spec/02) ===
# Runtime artifacts (TTS audio, composed video, thumbnails, uploaded media) —
# regenerated on demand, were mistakenly tracked. The root `static/uploads/`
# rule (line 2) is anchored and does NOT cover these backend subtrees.
backend-services/basic-service/static/audio/generated/
backend-services/basic-service/static/video/composed/
backend-services/basic-service/static/video/thumbnails/
backend-services/basic-service/static/uploads/

# Deploy tarballs (ops/*.tgz) — large build packages, never source.
*.tgz

# Windows null-device / noise file accidentally created by redirects.
nul

# === Coverage / run artifacts (docs/plans/desktop-only-refactor P0) ===
# `coverage/` was tracked by mistake; it is a build product of `vitest --coverage`.
coverage/
/logs/
.run-log/
.claude-index/graph.json
