# ============================================================================
# Ecliptrix Backend - Environment Configuration
# Copy this file to .env and fill in your values.
#
# SECURITY (spec/05):
#   - This template MUST contain only placeholders (`your_*_here`). Never
#     commit real API keys here — `.env*` files are now blanket-blocked by
#     `.gitignore` (with `env.template` / `.env.example` allowlisted).
#   - Before deploying, copy to `.env`, fill real values, NEVER commit `.env`.
#   - The project memory notes `.env` was previously git-tracked and a
#     tarball-extract deploy can revert it; preserve `.env` across extracts.
#   - Production deploys MUST set CORS_ALLOWED_ORIGINS (see § below) — empty
#     allowlist in prod = all cross-origin requests blocked.
#   - Keys previously committed (Dashscope/Zhipu/Moonshot/Volcano/ARK/OSS/
#     Supabase JWT) MUST be rotated upstream — see REPORT.md.
# ============================================================================

# ===========================================
# LLM Configuration (Required)
# General purpose LLM for chat, workflow, intent detection
# Each group has an *_API_TYPE field:
#   openai    — OpenAI-compatible endpoint (/chat/completions, choices[].message.content)
#   anthropic — Anthropic-compatible endpoint (/v1/messages, content[].text)
# Default: openai
# ===========================================
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-next-80b-a3b-instruct
LLM_API_TYPE=openai

# Fast LLM (for quick operations like translate-search-query)
FAST_LLM_API_KEY=your_fast_llm_api_key_here
FAST_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FAST_LLM_MODEL=qwen3-next-80b-a3b-instruct
FAST_LLM_API_TYPE=openai

# ===========================================
# Video Cut LLM (for AI mixed editing)
# ===========================================
VIDEO_CUT_LLM_API_KEY=your_video_cut_llm_api_key_here
VIDEO_CUT_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_CUT_LLM_MODEL=qwen3-next-80b-a3b-instruct
VIDEO_CUT_LLM_API_TYPE=openai

# ===========================================
# Vision-Language LLM (for video frame analysis)
# ===========================================
VL_LLM_API_KEY=your_vl_llm_api_key_here
VL_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_LLM_MODEL=qwen-vl-plus
VL_LLM_API_TYPE=openai

# ===========================================
# Agent LLM Configuration (Optional)
# Each numbered config has its own *_TYPE (default openai).
# Example for Anthropic-compatible (e.g. Zhipu Anthropic endpoint):
#   AGENT_LLM_API_03_KEY=...
#   AGENT_LLM_API_03_URL=https://open.bigmodel.cn/api/anthropic
#   AGENT_LLM_03_MODEL=glm-4.5
#   AGENT_LLM_API_03_TYPE=anthropic
# ===========================================
AGENT_LLM_API_01_KEY=your_agent_llm_01_key_here
AGENT_LLM_API_01_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_01_MODEL=qwen3-next-80b-a3b-instruct
AGENT_LLM_API_01_TYPE=openai

AGENT_LLM_API_02_KEY=your_agent_llm_02_key_here
AGENT_LLM_API_02_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_02_MODEL=qwen3-next-80b-a3b-instruct
AGENT_LLM_API_02_TYPE=openai

# ===========================================
# Database Configuration (Required)
# PostgreSQL with async driver
# ===========================================
DATABASE_URL=postgresql+asyncpg://ecliptrix:ecliptrix@localhost:5432/ecliptrix

# ===========================================
# Storage Configuration
# Local filesystem storage (replaces Supabase)
# ===========================================
STORAGE_ROOT=static/uploads

# ===========================================
# Alibaba Cloud OSS Configuration (Optional)
# When OSS_ENABLED=true, new uploads go to OSS first.
# Falls back to local storage if OSS is unavailable.
# ===========================================
OSS_ENABLED=false
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your_bucket_name
# Optional: CDN domain for public file access, e.g. https://cdn.yourdomain.com
OSS_CDN_DOMAIN=
# Optional: key prefix for all uploaded objects, e.g. ecliptrix/
OSS_KEY_PREFIX=

# ===========================================
# Authentication (Required)
# Root user credentials — .env is the single source of truth for the root account.
# ROOT_* takes priority; ADMIN_* kept for backward compatibility.
# ===========================================
ROOT_USERNAME=admin
ROOT_PASSWORD=change_me_in_production

# Legacy variables (deprecated — used as fallback if ROOT_* not set)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ===========================================
# Invite Code (Optional)
# When set, users must provide this code to self-register.
# Leave empty or unset to disable self-registration.
# ===========================================
INVITE_CODE=

# ===========================================
# External API Keys
# ===========================================

# Pexels - Video search (comma-separated for multiple keys)
PEXELS_API_KEY=your_pexels_api_key_here

# Unsplash - Image search (comma-separated for multiple keys)
UNSPLASH_ACCESS_KEYS=your_unsplash_key_here

# RunningHub - FLUX image generation
RUNNING_HUB_API_KEY=your_running_hub_api_key_here

# ByteDance Ark - Seedance video generation (doubao-seedance-1-5-pro)
ARK_API_KEY=your_ark_api_key_here

# Freesound - Audio library
FREESOUND_API_KEY=your_freesound_api_key_here

# ===========================================
# Volcano TTS - Text-to-Speech (V3 大模型语音合成)
# As of 2026-05-15 the synthesis call uses the V3 API
# (/api/v3/tts/unidirectional) which authenticates with a single API Key
# from the NEW console + a resource id selector. The legacy APPID/ACCESS_TOKEN
# fields below remain so the ASR / voice-clone fallbacks keep working.
# ===========================================
# Required: V3 API Key (新版控制台 → API Key 管理)
VOLCANO_TTS_API_KEY=your_volcano_tts_api_key
# Optional: resource id selector — picks product tier + billing
#   seed-tts-2.0           character-billed 2.0 voices (default, *_uranus_bigtts / saturn_*_tob)
#   seed-tts-1.0           character-billed 1.0 voices (*_moon_bigtts / *_streaming)
#   seed-tts-1.0-concurr   concurrency-billed 1.0
VOLCANO_TTS_RESOURCE_ID=seed-tts-2.0

# Legacy V1 fields — still consumed by ASR / voice-clone fallback chains.
# TTS synthesis itself no longer reads these.
VOLCANO_TTS_APPID=your_volcano_tts_appid
VOLCANO_TTS_ACCESS_TOKEN=your_volcano_tts_access_token
VOLCANO_TTS_SECRET_KEY=your_volcano_tts_secret_key

# ===========================================
# Volcano ASR — 大模型流式语音识别 (WebSocket，字幕转录)
#
# 2026-05-15 起字幕转录走 wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
# 鉴权采用旧版控制台 header：
#   X-Api-App-Key   = VOLCANO_ASR_APPID
#   X-Api-Access-Key = ***REMOVED***
# 不再要求 PUBLIC_BASE_URL / VOLCANO_ASR_API_KEY；这两个字段保留只为后续迁移到
# 新版控制台单一 X-Api-Key 时复用。
#
# 留空时会回落到 VOLCANO_TTS_*；火山控制台对同一 APPID 的 TTS / ASR 单独授权，
# 若 TTS APPID 未开通 ASR 能力，请填入另一组已开通 ASR 的凭据。
# VOLCANO_ASR_SECRET_KEY 仍保留（voice-clone 链路消费，不影响 ASR）。
# ===========================================
# VOLCANO_ASR_APPID=your_volcano_asr_appid
# ***REMOVED***=your_volcano_asr_access_token
# VOLCANO_ASR_SECRET_KEY=your_volcano_asr_secret_key
#
# X-Api-Resource-Id 必须与火山控制台开通的计费版本匹配：
#   volc.bigasr.sauc.duration    豆包流式语音识别 1.0 - 小时版 (默认)
#   volc.bigasr.sauc.concurrent  豆包流式语音识别 1.0 - 并发版
#   volc.seedasr.sauc.duration   豆包流式语音识别 2.0 - 小时版
#   volc.seedasr.sauc.concurrent 豆包流式语音识别 2.0 - 并发版
# VOLCANO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
#
# 单段音频时长上限（秒）。超过该值，aprocess_audio_file 会在打开 WS 前直接
# 返回 ASR_CLIP_TOO_LONG。nostream 接口的实际上传窗口约 300 s。
# ASR_MAX_CLIP_SECONDS=300

# ===========================================
# YouTube Proxy (Required if server cannot access YouTube directly)
# Supports: socks5://host:port, http://host:port, https://host:port
# ===========================================
YOUTUBE_PROXY=

# ===========================================
# Storyboard Video Generation Queue
# Overrides config/storyboard-config.yaml when set.
# STORYBOARD_MAX_CONCURRENT_VIDEO is kept for backward compatibility
# (older deployments) — STORYBOARD_VIDEO_MAX_CONCURRENT is preferred.
# ===========================================
# STORYBOARD_VIDEO_MAX_CONCURRENT=3
# STORYBOARD_VIDEO_TIMEOUT_SECONDS=600
# STORYBOARD_VIDEO_POLL_INTERVAL_SECONDS=5
# STORYBOARD_VIDEO_JOB_RETENTION_SECONDS=3600
# STORYBOARD_MAX_CONCURRENT_VIDEO=3

# ===========================================
# Media Proxy (spec: video-editor-playback-optimization/05-backend-media-proxy)
# Same-origin streaming proxy for remote video/image CDNs. Defaults come
# from config/media-proxy-config.yaml; envs override them.
# ===========================================
# MEDIA_PROXY_MAX_SIZE_MB=1024
# MEDIA_PROXY_CONCURRENT_DOWNLOADS=16

# ===========================================
# Playback v2 feature flag (specs 01 + 08) + Phase 4 telemetry / killswitch
# ===========================================
# PLAYBACK_V2_ENABLED=false
# PLAYBACK_V2_ROLLOUT_PERCENT=0
# PLAYBACK_V2_FORCE_ENABLED_USER_IDS=
# Rolling window (minutes) for the in-memory playback metrics aggregator.
# PLAYBACK_V2_TELEMETRY_AGG_WINDOW_MIN=15
# Retention (hours) for the per-minute counter buckets used by the rollback
# threshold queries (spec 08 §4.4 data source).
# PLAYBACK_V2_TELEMETRY_AGG_RETENTION_HOURS=24
# When true, /api/admin/playback-metrics tags multi-worker deployments as
# degraded so the rollout-playbook scripts skip automated rollback decisions
# (spec Phase 4 §3.2.7). Set to false ONLY when you have an external (e.g.
# redis-backed) aggregator in place.
# PLAYBACK_V2_AGGREGATOR_REQUIRES_SINGLE_WORKER=true
# Client-side killswitch thresholds (also exposed via NEXT_PUBLIC_* in the
# frontend env.local). Phase 4 §4.3.
# NEXT_PUBLIC_PLAYBACK_V2_KILLSWITCH_REGRESSION=50
# NEXT_PUBLIC_PLAYBACK_V2_KILLSWITCH_STALLED=30

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ===========================================
# Deployment environment (spec/02 V02-A)
# Values: "production" (default), "development", "dev", "staging"
# Controls:
#   - CORS allowlist behaviour (prod: strict; dev: localhost merged in)
#   - HSTS header emission (only when env=production)
# ENV is read first; falls back to APP_ENV; defaults to "production".
# ===========================================
ENV=production

# ===========================================
# CORS allowlist (spec/02 V02-A)
# Comma-separated list of allowed Origin values. EMPTY in production =
# all cross-origin requests blocked (safe-by-default).
# Example:
#   CORS_ALLOWED_ORIGINS=https://ecliptrix.example.com,https://staging.example.com
# In dev (ENV=development), localhost:3000 / :3010 / 127.0.0.1:3000 / :3010
# are merged in automatically — no need to list them.
# ===========================================
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# CORS_LEGACY_WILDCARD — EMERGENCY ROLLBACK ONLY.
# When set to 1, restores the pre-spec/02-fix `allow_origins=["*"]` +
# `allow_credentials=True` behavior so ops can rollback in <60s without
# redeploying. This is a KNOWN VULNERABILITY (V02-A). Disable as soon as
# the rollback window closes.
# CORS_LEGACY_WILDCARD=0

# ===========================================
# Default-deny auth enforcement (api-authz-rate-limiting spec/01 §5)
# ===========================================
# When AUTH_ENFORCE_DEFAULT_DENY=1, SessionAuthMiddleware rejects ANY
# non-allowlisted request that lacks a valid session token with 401 (full
# default-deny). When 0/unset (the default), such requests pass through so
# behaviour is unchanged until the frontend token-carry audit (TODO 05)
# confirms every API call forwards Authorization. Valid tokens are always
# resolved and the user injected regardless of this flag, and the
# hard-protected endpoints (ai-video-generate / video-export /
# intent-detection) are ALWAYS enforced. Flip this to 1 only after the FE
# audit, to avoid regressing untokened calls (Risk R1).
# AUTH_ENFORCE_DEFAULT_DENY=0

# ===========================================
# Reverse-proxy body limit (informational)
# ===========================================
# When the editor autosaves a project, the PUT /api/video-projects/{id}
# payload includes the full timeline (uiState.currentTimelineState) plus
# materials. A typical project is ~30–80 KB; busy projects with many
# subtitle/video items can grow past 1 MB and very heavy ones to ~5 MB.
# Nginx defaults to client_max_body_size 1m, which would reject those
# saves with HTTP 413. Set client_max_body_size to at least 10m on any
# production reverse proxy in front of this service.
