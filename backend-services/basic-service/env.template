# ============================================
# Ecliptrix Backend - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# ===========================================
# LLM Configuration (Required)
# General purpose LLM for chat, workflow, intent detection
# ===========================================
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-next-80b-a3b-instruct

# Fast LLM (for quick operations like translate-search-query)
FAST_LLM_API_KEY=your_fast_llm_api_key_here
FAST_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FAST_LLM_MODEL=qwen3-next-80b-a3b-instruct

# ===========================================
# Video Cut LLM (for AI mixed editing)
# ===========================================
VIDEO_CUT_LLM_API_KEY=your_video_cut_llm_api_key_here
VIDEO_CUT_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_CUT_LLM_MODEL=qwen3-next-80b-a3b-instruct

# ===========================================
# Vision-Language LLM (for video frame analysis)
# ===========================================
VL_LLM_API_KEY=your_vl_llm_api_key_here
VL_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_LLM_MODEL=qwen-vl-plus

# ===========================================
# Agent LLM Configuration (Optional)
# ===========================================
AGENT_LLM_API_01_KEY=your_agent_llm_01_key_here
AGENT_LLM_API_01_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_01_MODEL=qwen3-next-80b-a3b-instruct

AGENT_LLM_API_02_KEY=your_agent_llm_02_key_here
AGENT_LLM_API_02_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_02_MODEL=qwen3-next-80b-a3b-instruct

# ===========================================
# Database Configuration (Required)
# PostgreSQL with async driver
# ===========================================
DATABASE_URL=postgresql+asyncpg://ecliptrix:ecliptrix@localhost:5432/ecliptrix

# ===========================================
# Storage Configuration
# Local filesystem storage (replaces Supabase)
# ===========================================
STORAGE_ROOT=static/uploads

# ===========================================
# Alibaba Cloud OSS Configuration (Optional)
# When OSS_ENABLED=true, new uploads go to OSS first.
# Falls back to local storage if OSS is unavailable.
# ===========================================
OSS_ENABLED=false
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your_bucket_name
# Optional: CDN domain for public file access, e.g. https://cdn.yourdomain.com
OSS_CDN_DOMAIN=
# Optional: key prefix for all uploaded objects, e.g. ecliptrix/
OSS_KEY_PREFIX=

# ===========================================
# Authentication (Required)
# Root user credentials — .env is the single source of truth for the root account.
# ROOT_* takes priority; ADMIN_* kept for backward compatibility.
# ===========================================
ROOT_USERNAME=admin
ROOT_PASSWORD=change_me_in_production

# Legacy variables (deprecated — used as fallback if ROOT_* not set)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ===========================================
# Invite Code (Optional)
# When set, users must provide this code to self-register.
# Leave empty or unset to disable self-registration.
# ===========================================
INVITE_CODE=

# ===========================================
# External API Keys
# ===========================================

# Pexels - Video search (comma-separated for multiple keys)
PEXELS_API_KEY=your_pexels_api_key_here

# Unsplash - Image search (comma-separated for multiple keys)
UNSPLASH_ACCESS_KEYS=your_unsplash_key_here

# Tavily - Web search (comma-separated for multiple keys)
TAVILY_API_KEYS=your_tavily_api_key_here

# RunningHub - FLUX image generation
RUNNING_HUB_API_KEY=your_running_hub_api_key_here

# ByteDance Ark - Seedance video generation (doubao-seedance-1-5-pro)
ARK_API_KEY=your_ark_api_key_here

# Freesound - Audio library
FREESOUND_API_KEY=your_freesound_api_key_here

# ===========================================
# Volcano TTS - Text-to-Speech
# ===========================================
VOLCANO_TTS_APPID=your_volcano_tts_appid
VOLCANO_TTS_ACCESS_TOKEN=your_volcano_tts_access_token
VOLCANO_TTS_SECRET_KEY=your_volcano_tts_secret_key

# ===========================================
# YouTube Proxy (Required if server cannot access YouTube directly)
# Supports: socks5://host:port, http://host:port, https://host:port
# ===========================================
YOUTUBE_PROXY=

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
